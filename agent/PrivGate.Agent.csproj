<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      net48 = .NET Framework 4.8.
      Supported OS: Windows 7 SP1 / Server 2008 R2 SP1 and later.
      Windows Server 2008 (non-R2) is NOT supported by .NET Framework 4.8;
      it tops out at .NET Framework 4.6 and would require a separate build
      with Newtonsoft.Json replacing System.Text.Json.
    -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PrivGate.Agent</RootNamespace>
    <AssemblyName>PrivGate.Agent</AssemblyName>
    <!--
      Explorer/taskbar branding for the EXE itself. agent/AppIcon.ico is a
      committed PNG-compressed multi-size ICO generated by
      scripts/gen-agent-icon.py from the same geometry as src/app/icon.svg
      (pure stdlib, no external tools). Runtime tray/window icons are drawn
      live by AppIcon.cs so they stay crisp at any DPI.
    -->
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <!--
      Keep the assembly version in lockstep with the client MSI ProductVersion.
      Both read PRIVGATE_VERSION (env); fallback matches package.json.
      UpdateManager compares this against pushed versions, so a mismatch here
      would make every update push look stale (or loop).
    -->
    <Version Condition="'$(PRIVGATE_VERSION)' != ''">$(PRIVGATE_VERSION)</Version>
    <Version Condition="'$(PRIVGATE_VERSION)' == ''">0.2.1</Version>
    <!--
      Cross-compiling net48 on macOS/Linux cannot run Fusion, so automatic
      redirects are off. App.config carries the explicit Unsafe redirect
      System.Text.Json 8.x needs (System.Memory asks for 4.0.4.1; the DLL is 6.0.0.0).
    -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AppConfig>App.config</AppConfig>
  </PropertyGroup>
  <!--
    Release builds must not ship debug symbols: the packaged agent (MSI / zip /
    deployment script) includes everything under agent/dist, so a PDB there
    would land inside production installs. Turn symbol generation off for
    Release so the published payload carries only what the broker needs.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <Target Name="CopyExplicitBindingRedirects" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)App.config"
          DestinationFiles="$(TargetPath).config"
          OverwriteReadOnlyFiles="true" />
  </Target>
  <Target Name="CopyExplicitBindingRedirectsOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)App.config"
          DestinationFiles="$(PublishDir)$(TargetFileName).config"
          OverwriteReadOnlyFiles="true" />
  </Target>
  <ItemGroup>
    <Compile Remove="helper/**" />
    <None Remove="helper/**" />
    <EmbeddedResource Remove="helper/**" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!--
      System.Text.Json is not inbox on .NET Framework; the NuGet package
      targets netstandard2.0 which is compatible with net461+.
    -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Provides net48 reference assemblies when building on macOS/Linux. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>

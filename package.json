    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.23",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }

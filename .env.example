AUTH_MODE=development
# Production: AUTH_MODE=entra and secrets of at least 32 characters.
# The server refuses the development placeholders when NODE_ENV=production.
SESSION_SECRET=change-me-to-a-long-random-string-32chars
TICKET_SIGNING_KEY=change-me-ticket-hmac-key-32chars-min
DEVICE_SECRET_KEY=change-me-aes-key-32chars-minimum!!

# Behind a reverse proxy, set the public origin and (optionally) trust headers:
# PRIVGATE_PUBLIC_ORIGIN=https://privgate.example.com
# PRIVGATE_TRUSTED_HOSTS=privgate.example.com
# PRIVGATE_TRUST_PROXY=1

# Optional Entra ID (AUTH_MODE=entra)
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_REDIRECT_URI=http://localhost:3000/api/auth/entra/callback
# PRIVGATE_DB=./data/privgate.db

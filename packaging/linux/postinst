#!/bin/sh
set -e
. /usr/share/debconf/confmodule

if ! getent group privgate >/dev/null; then
  addgroup --system privgate
fi
if ! getent passwd privgate >/dev/null; then
  adduser --system --ingroup privgate --home /var/lib/privgate --no-create-home --shell /usr/sbin/nologin privgate
fi
mkdir -p /var/lib/privgate /var/log/privgate
chmod 700 /var/lib/privgate

# $2 is the previously configured version on upgrade. Keep console.env listen
# settings and secrets; do not re-apply debconf defaults over an existing install.
if [ "$1" = "configure" ] && [ -n "${2:-}" ] && [ -f /var/lib/privgate/console.env ]; then
  /opt/privgate/bin/node /opt/privgate/write-env.cjs --dir /var/lib/privgate --preserve
else
  BIND="0.0.0.0"
  WEB_PORT="3000"
  AGENT_PORT="3001"

  db_get privgate-console/bind || true
  case "$RET" in
    *127.0.0.1*) BIND="127.0.0.1" ;;
    *) BIND="0.0.0.0" ;;
  esac
  db_get privgate-console/web_port || true
  WEB_PORT="${RET:-3000}"
  db_get privgate-console/agent_port || true
  AGENT_PORT="${RET:-3001}"

  INI="$(mktemp)"
  chmod 600 "$INI"
  {
    printf 'bind=%s\n' "$BIND"
    printf 'webPort=%s\n' "$WEB_PORT"
    printf 'agentPort=%s\n' "$AGENT_PORT"
  } > "$INI"

  /opt/privgate/bin/node /opt/privgate/write-env.cjs --dir /var/lib/privgate --ini "$INI"
  rm -f "$INI"
fi

chown -R privgate:privgate /var/lib/privgate /var/log/privgate
systemctl daemon-reload
systemctl enable privgate.service
systemctl restart privgate.service
echo "PrivGate Console: http://127.0.0.1:${WEB_PORT:-3000}/setup  (create the Master Admin in the browser)"
echo "Windows brokers:  http://<this-host>:${AGENT_PORT:-3001}/"

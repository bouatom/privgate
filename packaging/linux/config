#!/bin/sh
set -e
. /usr/share/debconf/confmodule
db_version 2.0

# In-place upgrade: keep existing listen settings. dpkg-reconfigure still asks.
if [ "$1" != "reconfigure" ] && [ -f /var/lib/privgate/console.env ]; then
  exit 0
fi

db_input high privgate-console/bind || true
db_input high privgate-console/web_port || true
db_input high privgate-console/agent_port || true
db_go || true
